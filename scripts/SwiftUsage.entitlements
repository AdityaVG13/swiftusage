<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Lets the hardened runtime load Homebrew's or MacPorts' libzstd, which aren't signed by the same
         team, to read Codex's compressed rollouts (Sources/UsageCore/Providers/Zstd.swift). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
